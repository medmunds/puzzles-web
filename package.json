{
  "name": "puzzles-web",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^12.5.0",
      "onFail": "download"
    },
    "runtime": {
      "name": "node",
      "version": "^24.0.0",
      "onFail": "download"
    }
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "preview:pages": "wrangler pages dev dist",
    "format": "biome format --write .",
    "lint": "biome lint .",
    "check": "biome check --write .",
    "prepare": "husky"
  },
  "dependencies": {
    "@awesome.me/webawesome": "^3.5.0",
    "@lit-labs/observers": "^2.1.0",
    "@lit-labs/signals": "^0.2.0",
    "@lit/context": "^1.1.6",
    "@material-design-icons/svg": "^0.14.15",
    "@sentry/browser": "^10.49.0",
    "@sentry/wasm": "^10.49.0",
    "colorjs.io": "^0.5.2",
    "comlink": "^4.4.2",
    "dexie": "^4.4.2",
    "lit": "^3.3.2",
    "lucide-static": "^1.46.0",
    "signal-utils": "^0.21.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@mdit/plugin-attrs": "^1.3.1",
    "@mdit/plugin-icon": "^1.1.1",
    "@sentry/vite-plugin": "^5.4.0",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^24.13.6",
    "@vite-pwa/assets-generator": "^1.0.2",
    "handlebars": "^4.7.9",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "markdown-it": "^15.0.2",
    "markdown-it-anchor": "^10.0.0",
    "rollup-plugin-license": "^3.7.1",
    "rollup-plugin-visualizer": "^7.1.1",
    "tinyglobby": "^0.2.17",
    "typescript": "^6.0.3",
    "vite": "^7.3.6",
    "vite-plugin-pwa": "^1.3.0",
    "vite-plugin-sitemap": "^0.8.2",
    "workbox-core": "^7.4.1",
    "workbox-precaching": "^7.4.1",
    "workbox-routing": "^7.4.1",
    "workbox-window": "^7.4.1",
    "wrangler": "^4.135.0"
  },
  "lint-staged": {
    "*.{js,ts,jsx,tsx,json,css,html}": [
      "biome check --write --no-errors-on-unmatched"
    ]
  }
}
