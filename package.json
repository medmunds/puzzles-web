{
  "name": "puzzles-web",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.18.0",
      "onFail": "download"
    },
    "runtime": {
      "name": "node",
      "version": "^24.22.2",
      "onFail": "download"
    }
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "preview:pages": "wrangler pages dev dist",
    "format": "biome format --write .",
    "lint": "biome lint .",
    "check": "biome check --write .",
    "prepare": "husky"
  },
  "dependencies": {
    "@awesome.me/webawesome": "^3.14.0",
    "@lit-labs/observers": "^2.1.0",
    "@lit-labs/signals": "^0.3.0",
    "@lit/context": "^1.1.6",
    "@material-design-icons/svg": "^0.14.15",
    "@sentry/browser": "^11.11.0",
    "@sentry/wasm": "^11.11.0",
    "colorjs.io": "^0.5.2",
    "comlink": "^4.4.2",
    "dexie": "^4.4.7",
    "lit": "^3.3.3",
    "lucide-static": "^1.69.0",
    "signal-utils": "^0.21.1"
  },
  "devDependencies": {
    "@biomejs/biome": "~2.5.15",
    "@mdit/plugin-attrs": "^1.4.0",
    "@mdit/plugin-icon": "^1.1.4",
    "@sentry/vite-plugin": "~5.4.1",
    "@types/node": "^24.19.2",
    "@vite-pwa/assets-generator": "^2.0.0",
    "handlebars": "^4.7.10",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "markdown-it": "^15.0.3",
    "markdown-it-anchor": "^10.1.0",
    "rollup-plugin-license": "^3.7.1",
    "rollup-plugin-visualizer": "^7.1.2",
    "tinyglobby": "^0.2.17",
    "typescript": "^6.0.3",
    "vite": "^7.3.7",
    "vite-plugin-pwa": "^2.0.0",
    "vite-plugin-sitemap": "^0.8.2",
    "workbox-core": "^7.4.1",
    "workbox-precaching": "^7.4.1",
    "workbox-routing": "^7.4.1",
    "workbox-window": "^7.4.1",
    "wrangler": "^4.158.0"
  },
  "lint-staged": {
    "*.{js,ts,jsx,tsx,json,css,html}": [
      "biome check --write --no-errors-on-unmatched"
    ]
  }
}
